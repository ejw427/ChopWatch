#!/bin/sh
# Auto-bump app version before each commit (see scripts/bump-version-on-commit.ps1).

if [ -f .git/MERGE_HEAD ] || [ -f .git/REBASE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version-on-commit.ps1
fi

if command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version-on-commit.ps1
fi

echo "pre-commit: pwsh or powershell is required for version bumping." >&2
exit 1
