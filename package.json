{
  "name": "chopwatch",
  "version": "0.5.6",
  "private": true,
  "license": "MIT",
  "description": "Read-only local Salad chopping dashboard",
  "author": "Eric Welch",
  "repository": {
    "type": "git",
    "url": "https://github.com/ejw427/ChopWatch.git"
  },
  "scripts": {
    "install:all": "npm install --prefix helper && npm install --prefix web && npm install --prefix desktop",
    "postinstall": "npm run install:all",
    "helper": "npm start --prefix helper",
    "web": "npm run dev --prefix web",
    "desktop": "npm start --prefix desktop",
    "start": "concurrently -k -n helper,web -c green,cyan \"npm run helper\" \"npm run web\"",
    "app": "concurrently -k -n web,desktop -c cyan,magenta \"npm run web\" \"npm run desktop\"",
    "stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stop.ps1",
    "restart:helper": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-restart-helper.ps1",
    "rebuild:restart": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-rebuild-restart.ps1",
    "snapshot": "node helper/src/cli-snapshot.js",
    "test": "npm test --prefix helper",
    "test:watch": "npm run test:watch --prefix helper",
    "build": "npm run build --prefix web",
    "dist": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/pack-desktop.ps1",
    "dist:dir": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/pack-desktop.ps1 -DirOnly",
    "docs:html": "node scripts/md-to-html.mjs",
    "docs:view": "node scripts/md-to-html.mjs --open",
    "brand:icons": "node brand/generate-icons.mjs",
    "hooks": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-git-hooks.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
