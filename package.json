{
  "name": "chopwatch",
  "version": "0.5.0",
  "private": true,
  "description": "Read-only local Salad chopping dashboard",
  "author": "Eric Welch",
  "repository": {
    "type": "git",
    "url": "https://github.com/ejw427/ChopWatch.git"
  },
  "scripts": {
    "install:all": "npm install --prefix helper && npm install --prefix web",
    "postinstall": "npm run install:all",
    "helper": "npm start --prefix helper",
    "web": "npm run dev --prefix web",
    "start": "concurrently -k -n helper,web -c green,cyan \"npm run helper\" \"npm run web\"",
    "snapshot": "node helper/src/cli-snapshot.js",
    "test": "npm test --prefix helper",
    "test:watch": "npm run test:watch --prefix helper",
    "build": "npm run build --prefix web",
    "docs:html": "node scripts/md-to-html.mjs",
    "docs:view": "node scripts/md-to-html.mjs --open",
    "hooks": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-git-hooks.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
